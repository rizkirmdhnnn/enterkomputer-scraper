# Copy file ini ke `.env` lalu sesuaikan. Scraper otomatis baca file ini
# saat startup. Semua variabel opsional — default-nya udah jalan di
# macOS, Linux, dan Windows kalau Chrome ada di lokasi standar.

# --- Browser ---
# Override hanya kalau Chrome (atau Chromium/Brave) ada di lokasi non-standar.
# Default-nya auto-detect. Pakai path ke binary asli, bukan wrapper .app/.exe di macOS.
# EK_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# EK_CHROME_PATH=/usr/bin/google-chrome
# EK_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Tampilkan window Chrome saat run (buat debug). Default-nya disembunyiin.
# EK_SHOW_BROWSER=1

# Posisi window saat disembunyiin (kalau EK_SHOW_BROWSER nggak di-set).
# Pakai koordinat yang jauh di luar layar monitor kamu.
# EK_OFFSCREEN_POSITION=-2400,-2400
# EK_WINDOW_SIZE=1280,800

# Maksimal detik nunggu Cloudflare challenge selesai.
# EK_CF_WAIT_SECS=30

# --- Situs (override kalau fork buat situs Cloudflare lain) ---
# EK_BASE_URL=https://www.enterkomputer.com/
# EK_SITEMAP_URL=https://www.enterkomputer.com/sitemap.xml

# --- Discovery ---
# Detik jeda antar kunjungan listing-page saat tahap discover.
# Lebih besar = lebih ringan ke server.
# EK_DISCOVER_DELAY=3.0
# EK_LOAD_MORE_MAX_CLICKS=50
# EK_LOAD_MORE_WAIT=1.5

# --- Scraping ---
# Detik jeda antar request ke detail page. CLI flag --rate menang dari ini.
# Default 3.0. Kalau di-kecilin lebih cepat tapi lebih berat ke server.
# EK_SCRAPE_RATE=3.0

# Profile browser yang di-mimik curl_cffi. Lihat docs curl_cffi buat opsi lain.
# EK_IMPERSONATE=chrome120
