# Copy file ini ke `.env` lalu sesuaikan. Scraper akan auto-load saat startup.
# Semua variabel opsional — default-nya sudah bekerja di macOS, Linux, dan
# Windows kalau Chrome ada di lokasi standar.

# --- Browser ---
# Override hanya kalau Chrome (atau Chromium/Brave) ada di lokasi non-standar.
# Auto-detect by default. Pakai path ke binary asli, bukan wrapper .app/.exe di macOS.
# EK_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# EK_CHROME_PATH=/usr/bin/google-chrome
# EK_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Tampilkan window Chrome saat run (untuk debug). Default: tersembunyi offscreen.
# EK_SHOW_BROWSER=1

# Posisi window offscreen kalau EK_SHOW_BROWSER tidak diset.
# Pakai koordinat yang jauh di luar layar monitor kamu.
# EK_OFFSCREEN_POSITION=-2400,-2400
# EK_WINDOW_SIZE=1280,800

# Maksimal detik tunggu Cloudflare challenge clear.
# EK_CF_WAIT_SECS=30

# --- Situs (override hanya kalau fork untuk situs Cloudflare lain) ---
# EK_BASE_URL=https://www.enterkomputer.com/
# EK_SITEMAP_URL=https://www.enterkomputer.com/sitemap.xml

# --- Discovery ---
# Detik tidur antar navigasi listing-page saat discovery.
# Lebih tinggi = lebih sopan ke server origin.
# EK_DISCOVER_DELAY=3.0
# EK_LOAD_MORE_MAX_CLICKS=50
# EK_LOAD_MORE_WAIT=1.5

# --- Scraping ---
# Detik antar request ke detail page. CLI flag --rate menang dari ini.
# Default: 3.0 (polite). Nilai lebih kecil lebih cepat tapi lebih berat ke server.
# EK_SCRAPE_RATE=3.0

# Profile fingerprint browser yang di-mimik curl_cffi. Lihat docs curl_cffi
# untuk nilai valid lainnya.
# EK_IMPERSONATE=chrome120
