# Copy this file to `.env` and customize. The scraper auto-loads it on startup.
# All variables are optional — sensible defaults work out of the box on macOS,
# Linux, and Windows where Chrome is in a standard location.

# --- Browser ---
# Override only if Chrome (or Chromium/Brave) lives in a non-standard place.
# Auto-detected by default. Use the path to the actual binary, not the .app/.exe wrapper on macOS.
# EK_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# EK_CHROME_PATH=/usr/bin/google-chrome
# EK_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Show the Chrome window during runs (useful for debugging). Default: hidden offscreen.
# EK_SHOW_BROWSER=1

# Where to position the offscreen window when EK_SHOW_BROWSER is unset.
# Use a coordinate that's far outside any of your monitors.
# EK_OFFSCREEN_POSITION=-2400,-2400
# EK_WINDOW_SIZE=1280,800

# Maximum seconds to wait for the Cloudflare challenge to clear.
# EK_CF_WAIT_SECS=30

# --- Site (override only if you fork this for another Cloudflare-protected site) ---
# EK_BASE_URL=https://www.enterkomputer.com/
# EK_SITEMAP_URL=https://www.enterkomputer.com/sitemap.xml

# --- Discovery ---
# Seconds to sleep between listing-page navigations during discovery.
# Higher = more polite to the origin server.
# EK_DISCOVER_DELAY=3.0
# EK_LOAD_MORE_MAX_CLICKS=50
# EK_LOAD_MORE_WAIT=1.5

# --- Scraping ---
# Seconds between detail-page requests. CLI --rate flag overrides this.
# Default: 3.0 (polite). Lower values are faster but harder on the server.
# EK_SCRAPE_RATE=3.0

# curl_cffi browser fingerprint to impersonate. See curl_cffi docs for valid values.
# EK_IMPERSONATE=chrome120
